# Smart AI Gateway: every tunable setting lives in this file.
#
# Any value can be overridden without editing the file by an environment variable named
#   GW_<SECTION>_<KEY>      e.g.  GW_SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.95
# QDRANT_URL (used by docker-compose.yml and k8s/gateway.yaml) also overrides qdrant_url.
# To use a different file entirely, set GATEWAY_CONFIG=/path/to/other.config
# Lines starting with # or ; are comments.
#
# After editing this file, rebuild the image:  docker compose up --build

[semantic_cache]
# Qdrant server. Docker Compose and Kubernetes override this with QDRANT_URL.
qdrant_url = http://localhost:6333
collection_name = semantic_cache
# Embedding model and its vector size. Changing the model usually means a new size,
# and an existing collection with the old size must be deleted and recreated.
# Entries are tagged with the model that embedded them; entries from another model are
# never served and the sweeper deletes them. Also update the model name in the Dockerfile.
embedding_model = BAAI/bge-small-en-v1.5
embedding_dim = 384

# --- Matching: when a stored question counts as the same question ---
# Every match must also pass rule checks (same numbers, error codes and product names, no
# negation or opposite words like enable/disable in only one of the two questions).
#
# Cosine similarity at or above which a match is a hit straight away (0 to 1).
# Higher = stricter (fewer hits, fewer wrong answers). Lower = more hits, more risk.
# Thresholds depend on the models: re-check them after changing either
# (python smart_ai_gateway/scripts/evaluate_cache_matching.py). bge-small scores even
# different questions with similar wording around 0.85-0.93, so keep this high and let the
# verifier decide the rest.
similarity_threshold = 0.95
# Grey zone: matches between verify_threshold and similarity_threshold are re-checked by the
# verifier, a cross-encoder model that reads both questions together and is much better at
# telling "same question, different words" from "similar words, different question".
# Set verify_threshold = similarity_threshold to turn the verifier off (it is then not loaded).
verify_threshold = 0.75
verifier_model = cross-encoder/quora-roberta-base
# Verifier probability (0 to 1) that the two questions are the same, needed for a hit.
verifier_threshold = 0.50
# How many of the closest stored questions are considered (for the verifier and for decay).
search_candidates = 5
# Questions about "today", "latest", "this week" and similar are answered fresh every time:
# not served from the cache and not stored in it.
skip_time_sensitive = true

# --- Aging: how long a cached answer stays usable ---
# An entry older than ttl_seconds is never served; the next similar question goes to the LLM
# and its fresh answer is cached. 0 = entries never expire.
ttl_seconds = 86400
# true  = ttl_seconds counts from the entry's last cache hit, so popular answers stay.
# false = ttl_seconds counts from when the entry was stored.
sliding_ttl = true
# Hard cap on an entry's age since it was stored, however often it is hit. 0 = no cap.
max_age_seconds = 604800
# How often the sweeper deletes expired entries from Qdrant (docker compose; the Kubernetes
# CronJob in k8s/cache-sweep.yaml has its own schedule). Expired entries are never served
# either way; sweeping only frees storage.
sweep_interval_seconds = 3600
# Gradual aging: a match's score is multiplied by 0.5 for every half-life since the entry was
# stored, and must still reach similarity_threshold. Newer answers win over older ones, and
# loose matches expire sooner than exact ones. 0 = off (score is plain similarity).
decay_half_life_seconds = 0

[gateway]
# Request limits for /chat.
prompt_max_length = 4000
user_id_max_length = 128

[scheduler]
# The mock LLM's answer (used when [llm] provider = mock); {prompt} is replaced by the question.
mock_llm_response_template = Generated AI response to: {prompt}

[llm]
# The LLM that answers cache misses: gemini, or mock (no API key needed, answers instantly).
# Gemini needs an API key in the GEMINI_API_KEY environment variable, never in this file:
# see .env.example. Free keys: https://aistudio.google.com/apikey
provider = gemini
# Gemini's newest Flash-Lite model: fast, with higher free-tier limits than the Flash models,
# and strong enough for helpdesk answers. (gemini-3.8-flash is stronger but slower, and often
# overloaded on the free tier.) Free-tier limits are per Google project, shared by every
# gateway pod; check yours at https://aistudio.google.com/rate-limit
# Cached answers are tagged with this model: after changing it, older answers are not served.
model = gemini-3.5-flash-lite
# Answers are cached and reused for other employees, and the web page shows plain text.
system_instruction = You are the internal helpdesk assistant for company employees, answering IT, HR and workplace questions. Answer clearly and concisely in plain text, without Markdown formatting. Your answers are saved and reused for other employees who ask the same question, so do not address anyone by name or refer to earlier messages. If a question needs company-specific information you do not have, give general guidance and suggest contacting the IT or HR helpdesk.
# How much the model reasons before answering: minimal, low, medium or high (not every model
# supports every level). Lower = faster and uses fewer tokens. Empty = the model's default.
thinking_level = minimal
# Upper limit on answer length in tokens (thinking tokens count towards it).
max_output_tokens = 2048
# Give up on a Gemini call after this long; the user gets an error and nothing is cached.
timeout_seconds = 30
# Retries when Google's servers fail or are overloaded (500, 502, 503). Not retried: timeouts
# (504, the full wait is already spent) and rate limits (429, the free-tier limits are per
# minute and per day, so an immediate retry fails too).
max_retries = 1
