
# Python virtual environment
.venv/
venv/

# Python cache files
__pycache__/
*.py[cod]
*.egg-info/

# Environment variables and secrets
.env
.env.*
!.env.example

# IDE settings
.vscode/
.idea/

# Testing artifacts
.pytest_cache/
.coverage
htmlcov/

# Logs and OS files
*.log
.DS_Store
Thumbs.db

# Docker Compose local overrides
compose.override.yaml

# Gateway runtime logs (decision log, feedback log)
/data/

# Generated experiments stay ignored, except the reviewed paper_v1 snapshot.
eval/cost/results/*
!eval/cost/results/paper_v1/
eval/cost/results/paper_v1/*
!eval/cost/results/paper_v1/README.md
!eval/cost/results/paper_v1/comparison.json
!eval/cost/results/paper_v1/comparison.png
!eval/cost/results/paper_v1/snapshot_manifest.json
!eval/cost/results/paper_v1/main/
!eval/cost/results/paper_v1/threshold_0.90/
!eval/cost/results/paper_v1/threshold_0.95/
!eval/cost/results/paper_v1/threshold_0.97/
!eval/cost/results/paper_v1/threshold_0.99/
# Interrupted output files are never research artifacts.
eval/cost/results/paper_v1/**/raw/*.tmp
eval/runs/
