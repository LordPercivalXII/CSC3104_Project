{
  "uid": "gateway-demo",
  "title": "Smart AI Gateway — Demo",
  "description": "Live HTTP, semantic-cache and shared-scheduler metrics. Uses no user IDs or prompts as labels.",
  "tags": [
    "gateway",
    "demo"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "Gateway demo: live measurements",
      "description": "Only metrics from running gateway processes; no synthetic results.",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Start a Locust run manually, then watch the panels. Mock responses exercise caching and scheduling; their token counts are estimates and do not measure real model capacity or cost. **Instance = one scraped gateway process.** A rising instance count does not, by itself, prove that HPA scaled it. No data before the first requests is normal. Redis queue depth is shared and uses **max**, never the sum across replicas."
      }
    },
    {
      "id": 2,
      "title": "Reachable gateway instances",
      "description": "Number of currently successful Prometheus scrape targets. This is not a Kubernetes desired-replica metric.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(up{job=\"gateway\"} == 1) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "gateway-prometheus"
          },
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "title": "Chat requests / second",
      "description": "Completed /chat and /scheduler/chat HTTP responses; excludes health checks and /metrics.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gateway_http_requests_total{job=\"gateway\",method=\"POST\",route=~\"/chat|/scheduler/chat\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "gateway-prometheus"
          },
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "title": "Semantic cache hit %",
      "description": "Cache hits divided by all completed POST /chat requests; scheduler-only traffic excluded. Zero traffic has no useful hit ratio.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(gateway_chat_outcomes_total{job=\"gateway\",outcome=~\"direct_hit|verified_hit\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(gateway_http_requests_total{job=\"gateway\",method=\"POST\",route=\"/chat\"}[$__rate_interval])), 1e-9)",
          "datasource": {
            "type": "prometheus",
            "uid": "gateway-prometheus"
          },
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 5,
      "title": "Chat HTTP error %",
      "description": "All 4xx/5xx /chat and /scheduler/chat responses divided by their completed HTTP requests.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(gateway_http_requests_total{job=\"gateway\",method=\"POST\",route=~\"/chat|/scheduler/chat\",status=~\"[45]..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(gateway_http_requests_total{job=\"gateway\",method=\"POST\",route=~\"/chat|/scheduler/chat\"}[$__rate_interval])), 1e-9)",
          "datasource": {
            "type": "prometheus",
            "uid": "gateway-prometheus"
          },
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 6,
      "title": "Chat traffic by instance",
      "description": "Demonstrates which gateway processes completed requests. Each time series is scraped directly, not through a load-balanced Service.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(gateway_http_requests_total{job=\"gateway\",method=\"POST\",route=~\"/chat|/scheduler/chat\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gateway-prometheus"
          },
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "title": "Chat response latency: p50 and p95",
      "description": "Server-side response latency includes queueing. Histograms aggregate across instances; client timing can differ.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(gateway_http_request_duration_seconds_bucket{job=\"gateway\",method=\"POST\",route=~\"/chat|/scheduler/chat\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "gateway-prometheus"
          },
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gateway_http_request_duration_seconds_bucket{job=\"gateway\",method=\"POST\",route=~\"/chat|/scheduler/chat\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "gateway-prometheus"
          },
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "title": "Cache / inference outcomes",
      "description": "/chat outcomes from instrumented application decisions. Error categories are operational failures, not correctness judgments.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(gateway_chat_outcomes_total{job=\"gateway\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gateway-prometheus"
          },
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "title": "Shared queued requests and active inference",
      "description": "Queue depth is the same Redis value observed by several replicas: max avoids counting it multiple times. Active inference is local per process and can be summed.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(gateway_scheduler_queue_depth{job=\"gateway\"})",
          "legendFormat": "queued (shared Redis)",
          "datasource": {
            "type": "prometheus",
            "uid": "gateway-prometheus"
          },
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(gateway_inference_in_progress{job=\"gateway\"})",
          "legendFormat": "active inference",
          "datasource": {
            "type": "prometheus",
            "uid": "gateway-prometheus"
          },
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "id": 10,
      "title": "Phase latency: p95",
      "description": "scheduler_roundtrip includes queueing, quota waits, inference and result transport. It is not queue wait alone. Embedding/search/verifier phases are observed only when executed.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,phase) (rate(gateway_chat_phase_duration_seconds_bucket{job=\"gateway\"}[$__rate_interval])))",
          "legendFormat": "{{phase}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gateway-prometheus"
          },
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "id": 11,
      "title": "Inference calls by result",
      "description": "Counts inference function invocations, not provider SDK retry attempts. Cached and coalesced responses do not start another inference call.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider,result) (rate(gateway_inference_calls_total{job=\"gateway\"}[$__rate_interval]))",
          "legendFormat": "{{provider}} / {{result}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gateway-prometheus"
          },
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "id": 12,
      "title": "Inference execution latency: p95",
      "description": "Time inside the inference function, excluding scheduler queueing. Mock delay is deliberately artificial.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,provider) (rate(gateway_inference_duration_seconds_bucket{job=\"gateway\"}[$__rate_interval])))",
          "legendFormat": "{{provider}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gateway-prometheus"
          },
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "id": 13,
      "title": "Token usage / second",
      "description": "Tokens from actual inference results, counted once per inference call. Mock values are estimates. This is not a billing or dollar-cost measure.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(gateway_llm_tokens_total{job=\"gateway\"}[$__rate_interval]))",
          "legendFormat": "{{kind}} tokens / s",
          "datasource": {
            "type": "prometheus",
            "uid": "gateway-prometheus"
          },
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "id": 14,
      "title": "Serving configuration by instance",
      "description": "Check provider/model/backend before sending traffic; mock is the default demo provider.",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gateway_info{job=\"gateway\"}",
          "format": "table",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "gateway-prometheus"
          }
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}
